{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "configura",
            "type": "shell",
            "command": "cmake -S . -B build",
            "problemMatcher": []
        },
        {
            "label": "compila",
            "type": "shell",
            "command": "cmake --build build",
            "dependsOn": "configura",
            "group": { "kind": "build", "isDefault": true },
            "problemMatcher": "$gcc"
        },
        {
            "label": "esegui",
            "type": "shell",
            "command": "./spaceinvaders",
            "options": { "cwd": "${workspaceFolder}/build" },
            "dependsOn": "compila",
            "presentation": { "focus": true, "panel": "dedicated" },
            "problemMatcher": []
        }
    ]
}
